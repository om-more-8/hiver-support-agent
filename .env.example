# Copy this file to .env and fill in your key.
# Get a free/cheap key from Groq (fast, generous free tier) or OpenRouter (more model choice).


# OR OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_PROVIDER=

# Model name (Groq examples: llama-3.1-8b-instant, llama-3.3-70b-versatile)
LLM_MODEL=
